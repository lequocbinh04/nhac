{
  "name": "nhac",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted lossless music player on Cloudflare Workers. Streams FLAC, ALAC, WAV from Cloudflare R2 or any S3-compatible bucket.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "deploy": "npm run build && wrangler deploy",
    "types": "wrangler types --config wrangler.example.jsonc --strict-vars=false",
    "check": "tsc --noEmit && tsc --noEmit -p web",
    "test": "vitest run --config web/vite.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@preact/signals": "^2.11.4",
    "@tanstack/virtual-core": "^3.19.11",
    "aws4fetch": "^1.0.20",
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@preact/preset-vite": "^2.10.6",
    "typescript": "^5.9.0",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
